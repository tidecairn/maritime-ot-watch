# TIDECAIRN Maritime OT Watch repository text contract
# Canonical repository/served bytes use LF so SHA-256 sidecars are stable across Windows and CI.
* text=auto
*.json text eol=lf
*.sha256 text eol=lf
*.py text eol=lf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.svg text eol=lf
